{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wiki-group-review-v1",
  "title": "Wiki Group proposal and discovery review receipt",
  "oneOf": [
    { "$ref": "#/$defs/proposal" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "threshold_assessment": {
      "type": "object",
      "required": ["conditions", "reason", "review_by", "review_when", "members", "group_semantic_sha256", "input_hashes", "evidence", "not_a_permanent_waiver"],
      "properties": {
        "conditions": { "type": "array", "minItems": 1, "items": { "enum": ["seed", "breadth"] }, "uniqueItems": true },
        "reason": { "type": "string", "minLength": 1 },
        "review_by": { "type": "string", "format": "date-time" },
        "review_when": { "type": "string", "minLength": 1 },
        "members": { "type": "array", "items": { "type": "string", "pattern": "^wiki/[^/\\\\]+\\.md$" }, "uniqueItems": true },
        "group_semantic_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "input_hashes": { "type": "object", "propertyNames": { "pattern": "^wiki/[^/\\\\]+\\.md$" }, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "evidence": { "type": "string", "minLength": 1 },
        "not_a_permanent_waiver": { "const": true }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["path", "decision", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["include", "exclude", "unresolved"] },
        "reason": { "type": "string", "minLength": 1 },
        "coverage_axes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "review_when": { "type": "string" }
      },
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "required": ["schema_version", "kind", "id", "name", "group_kind", "entry_basis", "query_use_cases", "discovery_signals", "exclusion_signals", "coverage_axes", "approval"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "wiki_group_proposal" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "group_kind": { "enum": ["genre", "mechanic", "system", "experience", "method"] },
        "entry_basis": { "type": "array", "minItems": 1, "items": { "enum": ["semantic_standard", "relational_value"] }, "uniqueItems": true },
        "query_use_cases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "discovery_signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exclusion_signals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "coverage_axes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "candidate_members": { "type": "array", "items": { "type": "string", "pattern": "^wiki/.+\\.md$" }, "uniqueItems": true },
        "approval": { "enum": ["pending", "approved", "rejected"] }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["schema_version", "kind", "group_id", "repository_revision", "definition_hash", "screened_scope", "shortlisted", "decisions", "review_when"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "enum": ["wiki_group_discovery_receipt", "wiki_group_adjudication_receipt"] },
        "group_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "proposal_path": { "type": "string", "minLength": 1 },
        "proposal_approval": { "enum": ["pending", "approved", "rejected"] },
        "repository_revision": { "type": "string", "minLength": 1 },
        "definition_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "screened_scope": { "type": "object", "required": ["wiki_count", "metadata_and_headings"], "properties": { "wiki_count": { "type": "integer", "minimum": 0 }, "metadata_and_headings": { "type": "integer", "minimum": 0 }, "related_page_descriptions": { "type": "integer", "minimum": 0 }, "registry_index": { "type": "integer", "minimum": 0 }, "full_text_reviewed": { "type": "integer", "minimum": 0 }, "candidate_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
        "discovery_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclusion_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "shortlisted": { "type": "array", "items": { "type": "object" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "review_when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "threshold_assessment": { "$ref": "#/$defs/threshold_assessment" }
      },
      "additionalProperties": false
    }
  }
}
