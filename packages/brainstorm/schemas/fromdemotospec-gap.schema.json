{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tylerbrainstorm.local/schemas/fromdemotospec-gap-v2.json",
  "title": "Brainstorm FromDemoToSpec gap v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "session_id",
    "source_brief",
    "external_contract",
    "status",
    "structural_review",
    "semantic_review",
    "reviewer",
    "decision_ids",
    "external_flow_started",
    "fields",
    "tunable_parameters"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "adapter_id": {
      "const": "fromdemotospec-handoff"
    },
    "session_id": {
      "type": "string",
      "pattern": "^bs-[0-9]{8}-[0-9]{6}-[a-f0-9]{6}$"
    },
    "source_brief": {
      "const": "game-concept-brief.md"
    },
    "external_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "last_verified_against"
      ],
      "properties": {
        "path": {
          "const": "FromDemoToSpec/templates/design-baseline.md"
        },
        "version": {
          "const": "fromdemotospec-design-baseline-v2"
        },
        "last_verified_against": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "status": {
      "enum": [
        "gap-review",
        "ready"
      ]
    },
    "structural_review": {
      "const": "passed"
    },
    "semantic_review": {
      "enum": [
        "required",
        "passed",
        "failed"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "agent",
        "user",
        "joint"
      ]
    },
    "decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DEC-[0-9]{3,}$"
      }
    },
    "external_flow_started": {
      "const": false
    },
    "fields": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "fromdemotospec_target",
          "coverage",
          "mapped_content",
          "source_ids",
          "gap_or_question",
          "blocking",
          "next_action"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "fromdemotospec_target": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "enum": [
              "satisfied",
              "partial",
              "missing",
              "assumed",
              "fromdemotospec-question"
            ]
          },
          "mapped_content": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:RAW|IDEA|EVID|DEC)-[0-9]{3,}$"
            }
          },
          "gap_or_question": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
    "tunable_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter_id",
          "name",
          "default",
          "range",
          "source_ids"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "pattern": "^FromDemoToSpec-PARAM-[0-9]{3,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:RAW|IDEA|EVID|DEC)-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_sha256",
        "combinations_sha256",
        "decision_ledger_sha256"
      ],
      "properties": {
        "brief_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "combinations_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision_ledger_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
