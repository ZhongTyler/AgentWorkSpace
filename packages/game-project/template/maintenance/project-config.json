{
  "schema_version": 1,
  "template": {
    "name": "godot-project",
    "version": "0.2.5"
  },
  "project": {
    "id": "__PROJECT_ID__",
    "name": "__PROJECT_NAME__",
    "lifecycle": "formal-initialization"
  },
  "engine": {
    "directory": "Game",
    "state": "not_initialized",
    "godot_version": null,
